{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kura-edge",
  "version": "1.0.5",
  "identifier": "com.kura.edge",
  "build": {
    "frontendDist": "error"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": ["resources/app", "resources/jre"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
